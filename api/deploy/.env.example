# Template for ~/smarttoolbox/.env on the Pi. Copy it there and fill in real
# values; the real file is gitignored and is never touched by sync.ps1, so it
# survives redeploys.
#
# Reload after editing:  sudo systemctl restart smarttoolbox

# Shared secret for OTA firmware updates. Must match SECRET_DEVICE_KEY in
# firmware/arduino_secrets.h. While unset, /api/firmware/latest returns 503 and
# serves nothing - it deliberately does not fall back to open access, because
# this is the one endpoint that can overwrite the device's firmware.
DEVICE_KEY=

# Where the NAS's Whisper service listens, used until a URL is saved on the AI
# Settings page. Unset, it falls back to http://nas.local:9000.
NAS_WHISPER_URL=

# Optional OpenAI transcription fallback.
# OPENAI_API_KEY=
