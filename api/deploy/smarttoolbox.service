[Unit]
Description=SmartToolBox web server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=shields
WorkingDirectory=/home/shields/smarttoolbox
ExecStart=/bin/bash -lc 'mkdir -p /home/shields/smarttoolbox/logs && exec /home/shields/.bun/bin/bun run src/index.ts >> /home/shields/smarttoolbox/logs/service.log 2>> /home/shields/smarttoolbox/logs/service-error.log'
Restart=always
RestartSec=2
Environment=NODE_ENV=production
# Secrets live outside the repo: this unit file is tracked in git, so anything
# put in an Environment= line here gets committed. The leading '-' means the
# service still starts when the file is absent - the OTA endpoint fails closed
# on its own rather than taking the whole server down with it.
EnvironmentFile=-/home/shields/smarttoolbox/.env

[Install]
WantedBy=multi-user.target